# Postgres (local: docker / produção: Supabase — connection pooling na DATABASE_URL,
# conexão direta na DIRECT_URL para migrações)
DATABASE_URL="postgresql://postgres:polimatas@localhost:5432/polimatas?schema=public"
DIRECT_URL="postgresql://postgres:polimatas@localhost:5432/polimatas?schema=public"

# Segredo da sessão JWT (gere um valor longo e aleatório em produção)
SESSION_SECRET="troque-me"

# Protege o endpoint /api/cron/tick (Vercel Cron envia como Bearer token)
CRON_SECRET="troque-me"

# WhatsApp via Evolution API (opcional — sem estas variáveis a ação
# "Enviar WhatsApp" das automações é pulada). Local: evolution/docker-compose.yml
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="troque-me"
EVOLUTION_INSTANCE="polimatas"
# Número (DDD + número) que recebe o aviso de venda fechada no seed
WHATSAPP_NOTIFY_NUMBER=""

# Auto-cadastro em /cadastro. Desligado por padrão: a equipe entra pelo
# "Adicionar membro" do administrador. Ligue só em demonstrações.
ALLOW_SELF_SIGNUP="false"
