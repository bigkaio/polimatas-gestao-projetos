# Postgres (local: docker / produção: Supabase — connection pooling na DATABASE_URL,
# conexão direta na DIRECT_URL para migrações)
DATABASE_URL="postgresql://postgres:polimatas@localhost:5432/polimatas?schema=public"
DIRECT_URL="postgresql://postgres:polimatas@localhost:5432/polimatas?schema=public"

# Segredo da sessão JWT (gere um valor longo e aleatório em produção)
SESSION_SECRET="troque-me"

# Protege o endpoint /api/cron/tick (Vercel Cron envia como Bearer token)
CRON_SECRET="troque-me"
